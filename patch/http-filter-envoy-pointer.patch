diff --git a/source/extensions/dynamic_modules/sdk/go/abi/envoy_pointer.go b/source/extensions/dynamic_modules/sdk/go/abi/envoy_pointer.go
new file mode 100644
--- /dev/null
+++ b/source/extensions/dynamic_modules/sdk/go/abi/envoy_pointer.go
@@ -0,0 +1,43 @@
+package abi
+
+import (
+	"unsafe"
+
+	"github.com/envoyproxy/envoy/source/extensions/dynamic_modules/sdk/go/shared"
+)
+
+// HttpFilterEnvoyPointer returns the raw Envoy pointer of the stream behind h,
+// the envoy_dynamic_module_type_http_filter_envoy_ptr that Envoy passed to the
+// module. It returns false when h is not a handle created by this package, for
+// example a fake in a test.
+//
+// The pointer lets a Go module hand a stream to native code in the same
+// process, which then calls the envoy_dynamic_module_callback_http_* functions
+// itself. The rules of the ABI apply: use the pointer only on the thread that
+// owns the stream, during a callback or a scheduled function, and never after
+// the stream was destroyed.
+func HttpFilterEnvoyPointer(h shared.HttpFilterHandle) (unsafe.Pointer, bool) {
+	d, ok := h.(*dymHttpFilterHandle)
+	if !ok || d == nil {
+		return nil, false
+	}
+	return unsafe.Pointer(d.hostPluginPtr), true
+}
+
+// HttpFilterConfigEnvoyPointer returns the raw Envoy pointer of the filter
+// config behind h, the envoy_dynamic_module_type_http_filter_config_envoy_ptr
+// that Envoy passed to the module. It returns false when h is not a handle
+// created by this package, for example a fake in a test.
+//
+// The pointer lets a Go module hand the filter config to native code in the
+// same process, which then calls the
+// envoy_dynamic_module_callback_http_filter_config_* functions itself. The
+// rules of the ABI apply: use the pointer only on the main thread, and only for
+// the life of the filter config.
+func HttpFilterConfigEnvoyPointer(h shared.HttpFilterConfigHandle) (unsafe.Pointer, bool) {
+	d, ok := h.(*dymConfigHandle)
+	if !ok || d == nil {
+		return nil, false
+	}
+	return unsafe.Pointer(d.hostConfigPtr), true
+}
diff --git a/source/extensions/dynamic_modules/sdk/go/abi/envoy_pointer_test.go b/source/extensions/dynamic_modules/sdk/go/abi/envoy_pointer_test.go
new file mode 100644
--- /dev/null
+++ b/source/extensions/dynamic_modules/sdk/go/abi/envoy_pointer_test.go
@@ -0,0 +1,59 @@
+package abi
+
+import (
+	"testing"
+	"unsafe"
+
+	"github.com/envoyproxy/envoy/source/extensions/dynamic_modules/sdk/go/shared"
+)
+
+// The abi package references the Envoy symbols. This test never calls them, so
+// the test binary needs only that the linker accepts the unresolved symbols.
+// Linux needs CGO_LDFLAGS=-Wl,--unresolved-symbols=ignore-all for this, and
+// macOS already links with dynamic lookup. A _test.go file cannot use cgo, so
+// the flag is not set here.
+
+type foreignHandle struct{ shared.HttpFilterHandle }
+
+type foreignConfigHandle struct{ shared.HttpFilterConfigHandle }
+
+func TestHttpFilterEnvoyPointer(t *testing.T) {
+	var marker byte
+	want := unsafe.Pointer(&marker)
+	h := &dymHttpFilterHandle{}
+	// The field has a cgo type, so the test sets it through its address.
+	*(*unsafe.Pointer)(unsafe.Pointer(&h.hostPluginPtr)) = want
+	got, ok := HttpFilterEnvoyPointer(h)
+	if !ok || got != want {
+		t.Fatalf("got %p, %v; want %p, true", got, ok, want)
+	}
+	for name, fh := range map[string]shared.HttpFilterHandle{
+		"foreign":   foreignHandle{},
+		"typed nil": (*dymHttpFilterHandle)(nil),
+		"nil":       nil,
+	} {
+		if p, ok := HttpFilterEnvoyPointer(fh); ok || p != nil {
+			t.Errorf("%s: got %p, %v; want nil, false", name, p, ok)
+		}
+	}
+}
+
+func TestHttpFilterConfigEnvoyPointer(t *testing.T) {
+	var marker byte
+	want := unsafe.Pointer(&marker)
+	h := &dymConfigHandle{}
+	*(*unsafe.Pointer)(unsafe.Pointer(&h.hostConfigPtr)) = want
+	got, ok := HttpFilterConfigEnvoyPointer(h)
+	if !ok || got != want {
+		t.Fatalf("got %p, %v; want %p, true", got, ok, want)
+	}
+	for name, ch := range map[string]shared.HttpFilterConfigHandle{
+		"foreign":   foreignConfigHandle{},
+		"typed nil": (*dymConfigHandle)(nil),
+		"nil":       nil,
+	} {
+		if p, ok := HttpFilterConfigEnvoyPointer(ch); ok || p != nil {
+			t.Errorf("%s: got %p, %v; want nil, false", name, p, ok)
+		}
+	}
+}
